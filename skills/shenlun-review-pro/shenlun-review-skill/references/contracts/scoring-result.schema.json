{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scoring Result",
  "description": "Development scoring-core output, embedded by grade-once for ordinary grading. State-write callers may merge it into state-write-input; ordinary grading is read-only and must not append a write step.",
  "type": "object",
  "required": ["schema_version", "analysis_id", "question_type", "weight_policy", "user_answer", "answer_version", "full_score", "dimensions", "weight_total", "score_base", "diagnostic_total", "raw_center", "center_value", "interval", "confidence", "formal_score", "legacy_mode", "point_coverage", "coverage_summary", "supplementary_evidence", "scorable_point_count", "optional_point_count", "validation_receipt"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "question_type": { "type": "string", "enum": ["归纳概括", "综合分析", "提出对策", "贯彻执行", "申发论述"] },
    "weight_policy": { "type": "string", "enum": ["default", "official_override"] },
    "source_note": { "type": ["string", "null"] },
    "user_answer": { "type": "string", "minLength": 1 },
    "answer_version": { "type": "string", "enum": ["draft_1", "draft_2", "revision"] },
    "full_score": { "type": ["number", "null"] },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension_name", "weight", "level", "calculated_score"],
        "properties": {
          "dimension_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "level": { "type": "integer", "minimum": 0, "maximum": 4 },
          "calculated_score": { "type": "number" },
          "note": { "type": "string" },
          "anchor_evidence": { "type": "string", "description": "Optional. 可观察证据支撑当前层级判断。" },
          "upgrade_condition": { "type": "string", "description": "Optional. 层级1/2/3的升级条件。" },
          "borderline_decision": {
            "type": ["object", "null"],
            "description": "Optional. 临界档裁决记录。",
            "properties": {
              "current_level": { "type": "integer", "minimum": 0, "maximum": 4 },
              "target_level": { "type": "integer", "minimum": 0, "maximum": 4 },
              "took_lower": { "type": "boolean" },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "weight_total": { "type": "number" },
    "score_base": { "type": "number" },
    "diagnostic_total": { "type": "number" },
    "raw_center": { "type": "number" },
    "center_value": { "type": "number" },
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "formal_score": {
      "type": "boolean",
      "description": "Whether this result came from formal scoring. false for legacy mode."
    },
    "legacy_mode": {
      "type": "boolean",
      "description": "Whether this result was computed in legacy (compatibility) mode."
    },
    "legacy_warning": {
      "type": "string",
      "description": "Warning message when legacy mode is active. Not present in formal mode."
    },
    "point_coverage": {
      "type": "array",
      "description": "Scorable points only — optional, merged, excluded, and non-independent points are excluded.",
      "items": {
        "type": "object",
        "required": ["point_id", "coverage_status"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "coverage_status": { "type": "string", "enum": ["完整覆盖", "部分覆盖", "等义表达", "未覆盖", "超出材料"] },
          "user_quote": { "type": ["string", "null"] },
          "point_value": { "type": ["number", "null"], "minimum": 0, "description": "该点满分值。逐点计分模式下有值。" },
          "earned_value": { "type": ["number", "null"], "minimum": 0, "description": "实得分数。逐点计分模式下有值。" },
          "match_type": { "type": ["string", "null"], "enum": ["keyword_match", "semantic_match", "no_match", "extra_material", null] },
          "expansion_level": { "type": ["string", "null"], "enum": ["充分展开", "基本展开", "简略提及", "仅列标题", "未提及", null] }
        }
      }
    },
    "supplementary_evidence": {
      "type": "array",
      "description": "Non-scorable points (optional, merged, excluded, non-independent). Each entry explicitly states: affects_score=false, display_role=optional_support.",
      "items": {
        "type": "object",
        "required": ["point_id", "point_status", "affects_score", "display_role"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "point_status": { "type": "string", "enum": ["已提及", "未提及", "可作补充"] },
          "affects_score": { "type": "boolean", "const": false },
          "display_role": { "type": "string", "const": "optional_support" },
          "user_quote": { "type": ["string", "null"] }
        }
      }
    },
    "leading_summary_audit": {
      "type": "array",
      "description": "前置概括词的只读审计视图；不重建点池，不重复计算后文覆盖。",
      "items": {
        "type": "object",
        "required": ["review_id", "body_quote", "point_ids", "status", "diagnosis", "mapped_point_coverage", "affects_point_coverage", "score_invariant", "automatic_point_deduction", "requires_dimension_review"],
        "properties": {
          "review_id": { "type": "string", "minLength": 1 },
          "summary_quote": { "type": ["string", "null"] },
          "body_quote": { "type": "string", "minLength": 1 },
          "point_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "type": "string", "enum": ["accurate", "omitted", "imprecise", "contradictory"] },
          "diagnosis": { "type": "string", "minLength": 1 },
          "display_message": { "type": "string", "minLength": 1 },
          "mapped_point_coverage": { "type": "array", "items": { "type": "object" } },
          "affects_point_coverage": { "type": "boolean", "const": false },
          "score_invariant": { "type": "boolean" },
          "automatic_point_deduction": { "type": "boolean", "const": false },
          "requires_dimension_review": { "type": "boolean" },
          "eligible_score_dimension": { "type": ["string", "null"], "enum": ["准确有据", "分类组织", null] },
          "derived_from": { "type": "string", "const": "score_ledger" }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "完整覆盖": { "type": "integer" },
        "部分覆盖": { "type": "integer" },
        "等义表达": { "type": "integer" },
        "未覆盖": { "type": "integer" },
        "超出材料": { "type": "integer" }
      }
    },
    "optional_evidence_summary": {
      "type": "object",
      "description": "Coverage statistics for non-scorable (non-independent or optional) points. These do not affect formal scoring.",
      "properties": {
        "完整覆盖": { "type": "integer" },
        "部分覆盖": { "type": "integer" },
        "等义表达": { "type": "integer" },
        "未覆盖": { "type": "integer" },
        "超出材料": { "type": "integer" }
      }
    },
    "scorable_point_count": { "type": "integer", "description": "Number of scorable points (active + independent_scoring=true + required_or_optional!=optional)" },
    "optional_point_count": { "type": "integer", "description": "Number of non-scorable optional/supporting points in input" },
    "point_scoring_mode": {
      "type": "string",
      "enum": ["by_points", "by_dimensions"],
      "description": "逐点计分模式(by_points)或维度等级制(by_dimensions)。当所有scorable_point都有point_value时启用by_points。"
    },
    "essay_score_policy": {
      "type": ["object", "null"],
      "description": "申发论述先定档后档内定位的审核结果。",
      "properties": {
        "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
        "tier_label": { "type": "string", "enum": ["一类文", "二类文", "三类文", "四类文"] },
        "tier_ceiling": { "type": "number" },
        "reason": { "type": "string" },
        "original_center": { "type": "number" },
        "adjusted_center": { "type": "number" },
        "relationship_required": { "type": "boolean" },
        "relationship_centrality": { "type": "string", "enum": ["core", "supporting", "not_applicable"] },
        "relationship_coverage_status": { "type": "string" },
        "thesis_scope_status": { "type": "string" },
        "sub_argument_system_status": { "type": "string" },
        "material_transformation_status": { "type": "string" }
      }
    },
    "essay_diagnosis": {
      "type": ["object", "null"],
      "description": "大作文批改后的复盘诊断，不以分数为主，按主次问题、保留优点和修改顺序组织。",
      "properties": {
        "headline": { "type": "string" },
        "primary_issues": { "type": "array", "items": { "type": "object" } },
        "preserved_strengths": { "type": "array", "items": { "type": "string" } },
        "revision_order": { "type": "array", "items": { "type": "string" } },
        "score_is_secondary": { "type": "boolean", "const": true }
      }
    },
    "effort_score_applied": { "type": "boolean", "const": false, "description": "兼容字段；v0.3.80 起不再自动赠送辛苦分" },
    "point_scoring_summary": {
      "type": ["object", "null"],
      "description": "逐点计分汇总。仅point_scoring_mode=by_points时有值。",
      "properties": {
        "total_possible": { "type": "number", "description": "所有scorable_point的point_value之和" },
        "total_earned": { "type": "number", "description": "所有scorable_point的earned_value之和" },
        "coverage_rate": { "type": "number", "minimum": 0, "maximum": 1, "description": "total_earned / total_possible" },
        "weight_inversion_penalty": { "type": "number", "description": "权重倒置扣分总量" },
        "keyword_match_count": { "type": "integer", "description": "关键词精确匹配的点数" },
        "semantic_match_count": { "type": "integer", "description": "等义表达的点数" },
        "no_match_count": { "type": "integer", "description": "未匹配的点数" }
        ,"tier_position": { "type": "number", "minimum": 0, "maximum": 1, "description": "当前档位内的位置，0为下沿，1为上沿" }
        ,"tier_position_label": { "type": "string", "enum": ["上位", "中位", "下位"], "description": "当前档位内的上/中/下位" }
        ,"effort_score_applied": { "type": "boolean", "const": false, "description": "兼容字段；v0.3.80 起固定为 false" }
      }
    },
    "validation_receipt": {
      "type": "object",
      "required": ["passed", "checks", "scorable_point_count", "optional_point_count", "scored_mapping_count", "excluded_optional_mapping_count"],
      "properties": {
        "passed": { "type": "boolean" },
        "hard_passed": { "type": "boolean" },
        "status": { "type": "string", "enum": ["passed", "passed_with_warnings"] },
        "soft_warning_count": { "type": "integer", "minimum": 0 },
        "soft_warnings": { "type": "array", "items": { "type": "object" } },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["check_name", "passed", "detail"],
            "properties": {
              "check_name": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        },
        "scorable_point_count": { "type": "integer", "description": "Number of scorable points defined in point_definitions" },
        "optional_point_count": { "type": "integer", "description": "Number of non-scorable points in point_definitions" },
        "scored_mapping_count": { "type": "integer", "description": "Number of point_mappings that entered formal coverage_summary" },
        "excluded_optional_mapping_count": { "type": "integer", "description": "Number of point_mappings excluded from formal scoring (non-independent or optional)" }
      }
    }
  }
}
