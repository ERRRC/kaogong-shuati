{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "State Write Input",
  "description": "Explicit state-write development contract. Ordinary analysis/grading is read-only. Uses atomic_points (not material_points); write-state independently recomputes with the shared scoring core.",
  "type": "object",
  "required": [
    "schema_version", "analysis_id", "task_id", "question_type",
    "task_instruction", "material_hash", "user_answer", "answer_version",
    "dimensions", "weight_total", "score_base", "diagnostic_total",
    "raw_center", "center_value", "interval", "confidence",
    "point_coverage", "validation_receipt", "atomic_points",
    "weight_policy", "full_score"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "question_type": { "type": "string", "enum": ["归纳概括", "综合分析", "提出对策", "贯彻执行", "申发论述"] },
    "task_instruction": { "type": "string", "minLength": 1 },
    "material_hash": { "type": "string", "minLength": 1 },
    "user_answer": { "type": "string", "minLength": 1 },
    "answer_version": { "type": "string", "enum": ["draft_1", "draft_2", "revision"] },
    "weight_policy": { "type": "string", "enum": ["default", "official_override"] },
    "source_note": { "type": ["string", "null"] },
    "full_score": { "type": ["number", "null"] },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension_name", "weight", "level", "calculated_score"],
        "properties": {
          "dimension_name": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0 },
          "level": { "type": "integer", "minimum": 0, "maximum": 4 },
          "calculated_score": { "type": "number" },
          "note": { "type": "string" }
        }
      }
    },
    "weight_total": { "type": "number" },
    "score_base": { "type": "number" },
    "diagnostic_total": { "type": "number" },
    "raw_center": { "type": "number" },
    "center_value": { "type": "number" },
    "interval": {
      "type": "object",
      "required": ["lower", "upper"],
      "properties": {
        "lower": { "type": "number" },
        "upper": { "type": "number" }
      }
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "point_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point_id", "coverage_status"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "coverage_status": { "type": "string", "enum": ["完整覆盖", "部分覆盖", "等义表达", "未覆盖", "超出材料"] },
          "user_quote": { "type": ["string", "null"] }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "properties": {
        "完整覆盖": { "type": "integer" },
        "部分覆盖": { "type": "integer" },
        "等义表达": { "type": "integer" },
        "未覆盖": { "type": "integer" },
        "超出材料": { "type": "integer" }
      }
    },
    "atomic_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["point_id", "paragraph_id", "evidence_text", "point_text", "point_role", "importance", "independent_scoring", "status"],
        "properties": {
          "point_id": { "type": "string", "minLength": 1 },
          "paragraph_id": { "type": "string", "minLength": 1 },
          "evidence_text": { "type": "string", "minLength": 1 },
          "point_text": { "type": "string", "minLength": 1 },
          "point_role": { "type": "string", "enum": ["fact", "measure", "problem", "cause", "effect", "opinion", "data", "background"] },
          "importance": { "type": "string", "enum": ["core", "secondary", "potential"] },
          "independent_scoring": { "type": "boolean" },
          "qualifiers": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["active", "merged", "excluded"] }
        }
      }
    },
    "validation_receipt": {
      "type": "object",
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean", "const": true },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["check_name", "passed", "detail"],
            "properties": {
              "check_name": { "type": "string", "minLength": 1 },
              "passed": { "type": "boolean" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "method_card_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^sl-card-\\d{4}$" }
    }
  }
}
